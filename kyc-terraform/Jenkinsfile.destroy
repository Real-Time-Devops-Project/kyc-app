pipeline {
    agent any

    // The destroy pipeline controls checkout explicitly and timestamps every log line.
    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    // Region is parameterized so the same destroy job can target another AWS region when needed.
    parameters {
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region for Terraform destroy.')
    }

    // TF_VAR_region keeps Terraform's provider region aligned with the selected Jenkins parameter.
    environment {
        AWS_DEFAULT_REGION = "${params.AWS_REGION}"
        TF_VAR_region = "${params.AWS_REGION}"
        TF_DIR = 'kyc-terraform/environments/prod'
        TF_IN_AUTOMATION = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Initialize Terraform') {
            steps {
                // Connect to the configured remote backend before reading or destroying state.
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials-id']]) {
                    dir("${TF_DIR}") {
                        sh 'terraform init -input=false'
                    }
                }
            }
        }

        stage('Plan Destroy') {
            steps {
                // Generate a destroy plan first so reviewers can see exactly what will be removed.
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials-id'],
                    string(credentialsId: 'tf-var-postgres-password', variable: 'TF_VAR_postgres_password'),
                    string(credentialsId: 'tf-var-docdb-password', variable: 'TF_VAR_docdb_password')
                ]) {
                    dir("${TF_DIR}") {
                        sh 'terraform plan -destroy -input=false -out=tfdestroy'
                        sh 'terraform show -no-color tfdestroy > tfdestroy.txt'
                    }
                }
            }
        }

        stage('Confirm Destroy') {
            steps {
                // Final human approval gate for irreversible production teardown.
                input message: 'DANGER: destroy production infrastructure? This cannot be undone.', ok: 'Destroy Production'
            }
        }

        stage('Terraform Destroy') {
            steps {
                // Apply only the reviewed destroy plan.
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials-id'],
                    string(credentialsId: 'tf-var-postgres-password', variable: 'TF_VAR_postgres_password'),
                    string(credentialsId: 'tf-var-docdb-password', variable: 'TF_VAR_docdb_password')
                ]) {
                    dir("${TF_DIR}") {
                        sh 'terraform apply -input=false -auto-approve tfdestroy'
                    }
                }
            }
        }
    }

    post {
        always {
            // Preserve the destroy plan for audit and clean the Jenkins workspace afterward.
            archiveArtifacts artifacts: 'kyc-terraform/environments/prod/tfdestroy.txt', allowEmptyArchive: true
            cleanWs()
        }
    }
}
