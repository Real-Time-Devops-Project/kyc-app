pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t kyc-frontend:latest .'
            }
        }

        stage('Push to Registry') {
            when {
                branch 'main'
            }
            steps {
                sh 'echo "Pushing to registry..."'
            }
        }
    }
}
