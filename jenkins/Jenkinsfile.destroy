pipeline {
    agent any

    environment {
        AWS_CREDENTIALS = credentials('aws-credentials-id')
        TF_VAR_region = 'us-east-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform-project/environments/prod') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Plan Destroy') {
            steps {
                dir('terraform-project/environments/prod') {
                    // Plan the destroy to show what will be removed
                    sh 'terraform plan -destroy -out=tfdestroy'
                }
            }
        }

        stage('Confirm Destroy') {
            steps {
                script {
                    // Manual approval step
                    input message: '⚠️ DANGER: Are you sure you want to DESTROY the infrastructure? This cannot be undone.', ok: 'Yes, Destroy Everything'
                }
            }
        }

        stage('Terraform Destroy') {
            steps {
                dir('terraform-project/environments/prod') {
                    // Apply the destroy plan
                    sh 'terraform apply -auto-approve tfdestroy'
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
