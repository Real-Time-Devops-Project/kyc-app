pipeline {
    agent any
    tools { nodejs "${env.NODE_TOOL_NAME ?: 'nodejs-22-6-0'}" }
    
    environment {
        AWS_REGION       = "${env.AWS_REGION ?: 'us-east-1'}"
        ECR_REPO_NAME    = "${env.ECR_REPO_NAME ?: 'kyc-app'}"
        SERVICE_NAME     = "kyc-vkyc-service"
        HELM_CHART_DIR   = "../kyc-k8s"
        ENV_NAME         = "dev"
        AWS_ACCOUNT_ID   = credentials('aws-account-id')
        ECR_REPO_URI     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}"
        IMAGE_TAG        = "dev-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Build & Unit Test') {
            steps {
                dir('kyc-vkyc-service') {
                    sh 'npm ci'
                    sh 'npm test'
                }
            }
        }

        stage('Build & Push Image') {
            steps {
                dir('kyc-vkyc-service') {
                    script {
                        docker.build("${ECR_REPO_URI}:${IMAGE_TAG}").push()
                    }
                }
            }
        }

        stage('Deploy to Dev') {
            steps {
                sh "kubectl create namespace ${ENV_NAME} || true"
                dir("${HELM_CHART_DIR}") {
                    sh "helm upgrade --install ${SERVICE_NAME} . --namespace ${ENV_NAME} --set image.repository=${ECR_REPO_URI} --set image.tag=${IMAGE_TAG} -f values-dev.yaml"
                }
            }
        }

        stage('Dev Smoke Test') {
            steps {
                dir('kyc-vkyc-service') {
                    sh "./tests/smoke/health_check.sh"
                }
            }
        }
    }
}
