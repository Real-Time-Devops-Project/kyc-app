pipeline {
    agent any
    tools { nodejs "${env.NODE_TOOL_NAME ?: 'nodejs-22-6-0'}" }
    
    environment {
        AWS_REGION       = "${env.AWS_REGION ?: 'us-east-1'}"
        ECR_REPO_NAME    = "${env.ECR_REPO_NAME ?: 'kyc-app'}"
        SERVICE_NAME     = "kyc-ekyc-service"
        HELM_CHART_DIR   = "../kyc-k8s"
        ENV_NAME         = "qa"
        AWS_ACCOUNT_ID   = credentials('aws-account-id')
        ECR_REPO_URI     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}"
        IMAGE_TAG        = "qa-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Build & Push Image (QA)') {
            steps {
                dir('kyc-ekyc-service') {
                    script {
                        // Rebuild for QA or promote from Dev logic
                        docker.build("${ECR_REPO_URI}:${IMAGE_TAG}").push()
                    }
                }
            }
        }

        stage('Deploy to QA') {
            steps {
                sh "kubectl create namespace ${ENV_NAME} || true"
                dir("${HELM_CHART_DIR}") {
                    sh "helm upgrade --install ${SERVICE_NAME} . --namespace ${ENV_NAME} --set image.repository=${ECR_REPO_URI} --set image.tag=${IMAGE_TAG} -f values-qa.yaml"
                }
            }
        }

        stage('QA Test Suite') {
            parallel {
                stage('Integration Tests') {
                    steps {
                        dir('kyc-ekyc-service') {
                            sh "./tests/integration/run.sh" 
                        }
                    }
                }
                stage('Performance Tests') {
                    steps {
                        dir('kyc-ekyc-service') {
                            sh "k6 run tests/performance/load.js"
                        }
                    }
                }
                stage('Chaos Tests') {
                    steps {
                       dir('kyc-ekyc-service') {
                           sh "./tests/chaos/chaos_test.sh"
                       }
                    }
                }
            }
        }
    }
}
