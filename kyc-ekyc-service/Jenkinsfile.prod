pipeline {
    agent any
    
    environment {
        AWS_REGION       = "${env.AWS_REGION ?: 'us-east-1'}"
        ECR_REPO_NAME    = "${env.ECR_REPO_NAME ?: 'kyc-app'}"
        SERVICE_NAME     = "kyc-ekyc-service"
        HELM_CHART_DIR   = "../kyc-k8s"
        ENV_NAME         = "prod"
        AWS_ACCOUNT_ID   = credentials('aws-account-id')
        ECR_REPO_URI     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}"
        IMAGE_TAG        = "prod-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Promote Artifact') {
            steps {
                script {
                    // Logic to tag an existing QA image as PROD or rebuild strictly from Main
                    dir('kyc-ekyc-service') {
                         docker.build("${ECR_REPO_URI}:${IMAGE_TAG}").push()
                    }
                }
            }
        }

        stage('Pre-Deployment Check') {
            steps {
                input message: "Deploy to PRODUCTION?", ok: "Yes, Deploy"
            }
        }

        stage('Deploy to Prod') {
            steps {
                sh "kubectl create namespace ${ENV_NAME} || true"
                dir("${HELM_CHART_DIR}") {
                    sh "helm upgrade --install ${SERVICE_NAME} . --namespace ${ENV_NAME} --set image.repository=${ECR_REPO_URI} --set image.tag=${IMAGE_TAG} -f values-prod.yaml"
                }
            }
        }

        stage('Prod Validation') {
            steps {
                dir('kyc-ekyc-service') {
                    sh "./tests/smoke/health_check.sh"
                }
            }
        }
    }
}
